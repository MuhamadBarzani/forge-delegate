{
  "name": "forge-delegate",
  "version": "1.2.3",
  "mcpName": "io.github.MuhamadBarzani/forge-delegate",
  "description": "MCP server that delegates coding work from Claude Code, Codex or opencode to any model opencode can run, so your main agent's context stays small",
  "repository": {
    "type": "git",
    "url": "https://github.com/MuhamadBarzani/forge-delegate.git"
  },
  "homepage": "https://github.com/MuhamadBarzani/forge-delegate#readme",
  "type": "module",
  "bin": {
    "forge-delegate": "cli.mjs"
  },
  "scripts": {
    "setup": "node cli.mjs setup",
    "start": "node cli.mjs serve",
    "prepublishOnly": "node --check launcher.mjs && node --check cli.mjs && node --check server.mjs && node --check lib.mjs && node test-handshake.mjs"
  },
  "files": [
    "launcher.mjs",
    "cli.mjs",
    "server.mjs",
    "lib.mjs",
    "install.sh",
    "skills/",
    "docs/",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "claude",
    "claude-code",
    "ai",
    "deepseek",
    "gemini",
    "ollama",
    "delegation",
    "codex",
    "opencode",
    "mcp-server"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  }
}
