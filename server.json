{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.MuhamadBarzani/forge-delegate",
  "title": "forge-delegate",
  "description": "Delegate coding tasks from Claude Code, Codex or opencode to any model opencode can run.",
  "repository": {
    "url": "https://github.com/MuhamadBarzani/forge-delegate",
    "source": "github"
  },
  "version": "1.2.3",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "forge-delegate",
      "version": "1.2.3",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
